<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Only to notice the old Dip Watch app (which still holds the API key in plain text) and offer to uninstall it. -->
    <queries>
        <package android:name="fi.dipwatch" />
        <!-- To name the apps that may remove notifications when one disappears (Settings, last check). -->
        <intent>
            <action android:name="android.service.notification.NotificationListenerService" />
        </intent>
    </queries>

    <application
        android:label="${appLabel}"
        android:icon="@android:drawable/ic_menu_compass"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".ui.MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- The 08:00 alarm that shows notifications held overnight (work/NotificationGate.kt). -->
        <receiver android:name=".work.DeliverHeldReceiver" android:exported="false" />
    </application>
</manifest>
